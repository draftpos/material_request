<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_purchase_order_tree" model="ir.ui.view">
        <field name="name">custom.purchase.order.tree</field>
        <field name="model">custom.purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchase Order">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="transaction_date"/>
                <field name="order_deadline"/>
                <field name="amount_untaxed"/>
                <field name="amount_total"/>
                <field name="requisition_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_purchase_order_form" model="ir.ui.view">
        <field name="name">custom.purchase.order.form</field>
        <field name="model">custom.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight btn-success" invisible="state != 'pending_approval'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending_approval'"/>
                    <button name="action_confirm" string="Confirm Purchase Order" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state != 'po'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel', 'rejected', 'pending_approval')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved,po"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="purpose"/>
                            <field name="requested_by_id" readonly="1" widget="badge" decoration-warning="1"/>
                            <field name="request_to_ids" widget="many2many_tags" options="{'color_field': 'color'}" domain="[('group_ids', 'in', %(material_requisition.group_custom_purchase_order_approver)d)]" required="1"/>
                        </group>
                        <group>
                            <field name="order_deadline" decoration-success="1"/>
                            <field name="transaction_date"/>
                            <field name="approved_by_id" readonly="1" widget="badge" decoration-info="1"/>
                            <field name="requisition_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="taxes_id" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="notes" nolabel="1" placeholder="Define your terms and conditions ..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed" string="Total Excl. Amount" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.2em; color: black;"/>
                                    <field name="amount_tax" string="Taxes" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.2em; color: black;"/>
                                    <div class="oe_subtotal_footer_separator oe_inline">
                                        <label for="amount_total" string="Total Inclusive" style="font-weight: 900; font-size: 1.5em; color: black;"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.5em; color: black;"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_custom_purchase_order" model="ir.actions.act_window">
        <field name="name">Purchase Order</field>
        <field name="res_model">custom.purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Purchase Order
            </p>
        </field>
    </record>

    

    

    

    

    

    <record id="view_custom_purchase_order_search" model="ir.ui.view">
        <field name="name">custom.purchase.order.search</field>
        <field name="model">custom.purchase.order</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Reference"/>
<field name="transaction_date" string="Date"/>
<field name="create_uid" string="Created By"/>
<field name="purpose" string="Purpose"/>
<field name="state" string="Status"/>
<field name="order_deadline" string="Deadline Date"/>
<field name="vendor_id" string="Supplier"/>
<field name="requested_by_id" string="Requested By"/>
<field name="approved_by_id" string="Approved By"/>
<field name="requisition_id" string="Requisition Reference"/>
                <separator/>
                <filter string="Date" name="filter_transaction_date" date="transaction_date"/>
<filter string="My Created" name="my_created" domain="[('create_uid', '=', uid)]"/>
<filter string="Purpose: Purchase" name="purpose_purchase" domain="[('purpose', '=', 'Purchase')]"/>
<filter string="Purpose: Internal" name="purpose_internal" domain="[('purpose', '=', 'Internal')]"/>
<filter string="Deadline Date" name="filter_order_deadline" date="order_deadline"/>
<filter string="My Requests" name="my_requested" domain="[('requested_by_id', '=', uid)]"/>
<filter string="My Approvals" name="my_approved" domain="[('approved_by_id', '=', uid)]"/>
<separator/>
<filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
<filter string="Approved" name="state_approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Date" name="group_transaction_date" context="{'group_by': 'transaction_date'}"/>
<filter string="Created By" name="group_create_uid" context="{'group_by': 'create_uid'}"/>
<filter string="Purpose" name="group_purpose" context="{'group_by': 'purpose'}"/>
<filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
<filter string="Deadline Date" name="group_order_deadline" context="{'group_by': 'order_deadline'}"/>
<filter string="Supplier" name="group_vendor_id" context="{'group_by': 'vendor_id'}"/>
<filter string="Requested By" name="group_requested_by_id" context="{'group_by': 'requested_by_id'}"/>
<filter string="Approved By" name="group_approved_by_id" context="{'group_by': 'approved_by_id'}"/>
<filter string="Requisition Reference" name="group_requisition_id" context="{'group_by': 'requisition_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
