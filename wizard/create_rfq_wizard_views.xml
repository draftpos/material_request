<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_create_rfq_form" model="ir.ui.view">
        <field name="name">wizard.create.rfq.form</field>
        <field name="model">wizard.create.rfq</field>
        <field name="arch" type="xml">
            <form string="Create RFQ">
                <sheet>
                    <group>
                        <field name="requisition_id" invisible="1"/>
                        <field name="supplier_ids">
                            <list>
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="email"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_rfq" string="Create RFQs" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
